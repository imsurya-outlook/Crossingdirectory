@model TaxonomyFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit locality" : "Add locality";
}

<section class="page-head">
    <div class="container">
        <h1 class="h2 mb-1">@(Model.IsEdit ? "Edit locality" : "Add locality")</h1>
        <p class="text-muted mb-0">Localities are the geographic filter used across the portal.</p>
    </div>
</section>

<div class="container section">
    <div class="panel p-4 form-narrow">
        <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Crossing Republic" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DisplayOrder" class="form-label"></label>
                <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-brand" type="submit">@(Model.IsEdit ? "Save changes" : "Create locality")</button>
                <a class="btn btn-light" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
