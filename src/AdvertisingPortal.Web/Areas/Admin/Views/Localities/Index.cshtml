@model List<LocalityDto>
@{
    ViewData["Title"] = "Localities";
}

<section class="page-head">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1 class="h2 mb-1">Localities</h1>
            <p class="text-muted mb-0">@Model.Count locality(ies). Crossing Republic is the default locality.</p>
        </div>
        <a class="btn btn-brand" asp-action="Create"><i class="bi bi-plus-lg"></i> Add locality</a>
    </div>
</section>

<div class="container section">
    <partial name="_AdminNav" />

    <div class="panel mt-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Slug</th>
                        <th class="text-end">Order</th>
                        <th class="text-end">Ads</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var locality in Model)
                {
                    <tr>
                        <td class="fw-semibold">@locality.Name</td>
                        <td class="small text-muted">@locality.Slug</td>
                        <td class="text-end">@locality.DisplayOrder</td>
                        <td class="text-end">@locality.AdvertisementCount</td>
                        <td>
                            <span class="status-badge @(locality.IsActive ? "status-approved" : "status-inactive")">
                                @(locality.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-1 justify-content-end">
                                <a class="btn btn-sm btn-outline-brand" asp-action="Edit" asp-route-id="@locality.Id">Edit</a>
                                <form asp-action="ToggleActive" asp-route-id="@locality.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-light" type="submit">@(locality.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@locality.Id" method="post" onsubmit="return confirm('Remove this locality?');">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
