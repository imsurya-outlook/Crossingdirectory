@model AdvertisementFormViewModel
@{
    ViewData["Title"] = "Create advertisement";
}

<section class="page-head">
    <div class="container">
        <h1 class="h2 mb-1">Create advertisement</h1>
        <p class="text-muted mb-0">Add your business details, photos and contact information.</p>
    </div>
</section>

<div class="container section">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <partial name="_AdvertisementForm" model="Model" />
    </form>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
