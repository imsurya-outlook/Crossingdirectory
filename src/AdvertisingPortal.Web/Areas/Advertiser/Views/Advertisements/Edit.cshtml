@model AdvertisementFormViewModel
@{
    ViewData["Title"] = "Edit advertisement";
}

<section class="page-head">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1 class="h2 mb-1">Edit advertisement</h1>
            <p class="text-muted mb-0">Update details, manage photos or resubmit for approval.</p>
        </div>
        <a class="btn btn-light" asp-action="Index">Back to my ads</a>
    </div>
</section>

<div class="container section">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <partial name="_AdvertisementForm" model="Model" />
    </form>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
