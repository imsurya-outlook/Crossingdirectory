@model List<AdvertiserAdvertisementDto>
@{
    ViewData["Title"] = "My advertisements";
}

<section class="page-head">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1 class="h2 mb-1">My advertisements</h1>
            <p class="text-muted mb-0">@Model.Count listing(s)</p>
        </div>
        <a class="btn btn-brand" asp-action="Create"><i class="bi bi-plus-lg"></i> New advertisement</a>
    </div>
</section>

<div class="container section">
    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var ad in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="manage-card h-100">
                        <div class="manage-media">
                            @if (!string.IsNullOrEmpty(ad.PrimaryImageUrl))
                            {
                                <img src="@ad.PrimaryImageUrl" alt="@ad.Title" />
                            }
                            else
                            {
                                <div class="ad-card-placeholder"><i class="bi bi-image"></i></div>
                            }
                            <span class="status-badge status-@ad.Status.ToString().ToLower()">@ad.Status</span>
                        </div>
                        <div class="manage-body">
                            <h3 class="h6 mb-1">@ad.Title</h3>
                            <div class="small text-muted mb-2">@ad.CategoryName &middot; @ad.LocalityName</div>
                            <div class="metric-row">
                                <span><i class="bi bi-eye"></i> @ad.ViewCount views</span>
                                <span><i class="bi bi-cursor"></i> @ad.DetailsClickCount clicks</span>
                            </div>
                            <div class="d-flex gap-2 mt-3">
                                <a class="btn btn-sm btn-outline-brand" asp-action="Edit" asp-route-id="@ad.Id">Edit</a>
                                @if (ad.Status == AdvertisementStatus.Approved)
                                {
                                    <a class="btn btn-sm btn-light" asp-area="" asp-controller="Advertisements" asp-action="Details" asp-route-slug="@ad.Slug" target="_blank">View live</a>
                                }
                                @if (ad.Status == AdvertisementStatus.Draft || ad.Status == AdvertisementStatus.Rejected)
                                {
                                    <form asp-action="Submit" asp-route-id="@ad.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-brand" type="submit">Submit</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-megaphone"></i>
            <h3>No advertisements yet</h3>
            <p>Post your first advertisement to start appearing in local search.</p>
            <a class="btn btn-brand" asp-action="Create">Create advertisement</a>
        </div>
    }
</div>
