@model AdvertiserDashboardViewModel
@{
    ViewData["Title"] = "Advertiser dashboard";
}

<section class="page-head">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1 class="h2 mb-1">Your advertising dashboard</h1>
            <p class="text-muted mb-0">Track performance and manage your listings.</p>
        </div>
        <a class="btn btn-brand" asp-area="Advertiser" asp-controller="Advertisements" asp-action="Create">
            <i class="bi bi-plus-lg"></i> New advertisement
        </a>
    </div>
</section>

<div class="container section">
    <div class="row g-3">
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <span class="stat-label">Total views</span>
                <span class="stat-value">@Model.TotalViews</span>
                <span class="stat-hint">Detail page loads</span>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <span class="stat-label">Details clicks</span>
                <span class="stat-value">@Model.TotalClicks</span>
                <span class="stat-hint">Clicks from listings</span>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <span class="stat-label">Live ads</span>
                <span class="stat-value">@Model.LiveCount</span>
                <span class="stat-hint">Approved and visible</span>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card stat-warning">
                <span class="stat-label">Awaiting approval</span>
                <span class="stat-value">@Model.PendingCount</span>
                <span class="stat-hint">In moderation queue</span>
            </div>
        </div>
    </div>

    <div class="panel mt-4">
        <div class="panel-head">
            <h2 class="h5 mb-0">Your advertisements</h2>
            <a class="link-brand small" asp-area="Advertiser" asp-controller="Advertisements" asp-action="Index">Manage all</a>
        </div>

        @if (Model.Advertisements.Any())
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Advertisement</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Rating</th>
                            <th class="text-end">Views</th>
                            <th class="text-end">Clicks</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var ad in Model.Advertisements)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">
                                    @ad.Title
                                    @if (ad.IsVerified)
                                    {
                                        <i class="bi bi-star-fill verified-inline" title="Verified by our team"></i>
                                    }
                                </div>
                                <div class="small text-muted">@ad.LocalityName &middot; @ad.ImageCount image(s)</div>
                            </td>
                            <td>@ad.CategoryName</td>
                            <td>
                                <span class="status-badge status-@ad.Status.ToString().ToLower()">@ad.Status</span>
                                @if (ad.IsFeatured)
                                {
                                    <span class="status-badge status-featured mt-1">Featured</span>
                                }
                            </td>
                            <td>
                                @if (ad.RatingCount > 0)
                                {
                                    <partial name="_RatingStars" model="ad.AverageRating" />
                                    <span class="small text-muted d-block">@ad.AverageRating.ToString("0.0") from @ad.RatingCount</span>
                                }
                                else
                                {
                                    <span class="text-muted small">No ratings</span>
                                }
                            </td>
                            <td class="text-end">@ad.ViewCount</td>
                            <td class="text-end">@ad.DetailsClickCount</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-brand" asp-area="Advertiser" asp-controller="Advertisements" asp-action="Edit" asp-route-id="@ad.Id">Edit</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-megaphone"></i>
                <h3>No advertisements yet</h3>
                <p>Create your first listing with photos, contact details and a category.</p>
                <a class="btn btn-brand" asp-area="Advertiser" asp-controller="Advertisements" asp-action="Create">Create advertisement</a>
            </div>
        }
    </div>
</div>
