@model AdvertisementSearchViewModel
@{
    ViewData["Title"] = Model.HeadingOverride ?? "Browse advertisements";
}

<section class="page-head">
    <div class="container">
        <h1 class="h2 mb-1">@(Model.HeadingOverride ?? "Browse advertisements")</h1>
        <p class="text-muted mb-0">@Model.Results.TotalCount listing(s) found</p>
    </div>
</section>

<div class="container section">
    <form class="filter-bar" asp-controller="Advertisements" asp-action="Index" method="get">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                    <input class="form-control border-start-0" type="search" name="keyword" value="@Model.Keyword" placeholder="Search by name, service or category" />
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <select class="form-select" name="categoryId" asp-items="Model.CategoryOptions">
                    <option value="">All categories</option>
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <select class="form-select" name="localityId" asp-items="Model.LocalityOptions">
                    <option value="">All localities</option>
                </select>
            </div>
            <div class="col-12 col-lg-2">
                <button class="btn btn-brand w-100" type="submit">Apply filters</button>
            </div>
        </div>
    </form>

    @if (Model.Results.Items.Any())
    {
        <div class="row g-4 mt-1">
            @foreach (var ad in Model.Results.Items)
            {
                <partial name="_AdCard" model="ad" />
            }
        </div>

        @if (Model.Results.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.Results.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-categoryId="@Model.CategoryId" asp-route-localityId="@Model.LocalityId" asp-route-page="@(Model.Results.Page - 1)">Previous</a>
                    </li>
                    @for (var i = 1; i <= Model.Results.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Results.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-categoryId="@Model.CategoryId" asp-route-localityId="@Model.LocalityId" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.Results.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-categoryId="@Model.CategoryId" asp-route-localityId="@Model.LocalityId" asp-route-page="@(Model.Results.Page + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="empty-state mt-4">
            <i class="bi bi-search"></i>
            <h3>No advertisements match your filters</h3>
            <p>Try a different keyword, or clear the category and locality filters.</p>
            <a class="btn btn-outline-brand" asp-action="Index">Clear filters</a>
        </div>
    }
</div>
