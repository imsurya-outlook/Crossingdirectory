@model ApplicationUser
@{ ViewData["Title"] = "My profile"; }

<div class="container py-4">
    <h1 class="h4 fw-bold mb-4">My profile</h1>
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted small">Full name</dt>
                <dd class="col-sm-8">@Model.FullName</dd>
                <dt class="col-sm-4 text-muted small">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>
                <dt class="col-sm-4 text-muted small">Mobile</dt>
                <dd class="col-sm-8">@Model.PhoneNumber</dd>
                <dt class="col-sm-4 text-muted small">Locality</dt>
                <dd class="col-sm-8">@(Model.Locality ?? "-")</dd>
                <dt class="col-sm-4 text-muted small">Member since</dt>
                <dd class="col-sm-8">@Model.CreatedUtc.ToString("dd MMM yyyy")</dd>
            </dl>
        </div>
    </div>
</div>
