@model Advertisement
@{
    ViewData["Title"] = Model.BusinessName;
    var photos = Model.Photos.ToList();
    var similar = ViewData["Similar"] as List<Advertisement> ?? new List<Advertisement>();
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Directory" asp-action="Index" asp-route-category="@Model.Category?.Slug">@Model.Category?.Name</a></li>
            <li class="breadcrumb-item active">@Model.BusinessName</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            @if (photos.Any())
            {
                <div id="adGallery" class="carousel slide rounded-4 overflow-hidden shadow-sm mb-4" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @for (var i = 0; i < photos.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@photos[i].Url" class="d-block w-100 gallery-img" alt="@(photos[i].Caption ?? Model.BusinessName)" />
                            </div>
                        }
                    </div>
                    @if (photos.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#adGallery" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span><span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#adGallery" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span><span class="visually-hidden">Next</span>
                        </button>
                        <div class="carousel-indicators">
                            @for (var i = 0; i < photos.Count; i++)
                            {
                                <button type="button" data-bs-target="#adGallery" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
                            }
                        </div>
                    }
                </div>
            }

            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="badge chip"><i class="bi @(Model.Category?.Icon) me-1"></i>@Model.Category?.Name</span>
                @if (Model.IsFeatured)
                {
                    <span class="badge bg-brand text-dark"><i class="bi bi-star-fill me-1"></i>Featured</span>
                }
                <span class="small text-muted"><i class="bi bi-eye me-1"></i>@Model.ViewCount views</span>
            </div>

            <h1 class="h3 fw-bold mb-2">@Model.BusinessName</h1>
            <p class="text-muted mb-4"><i class="bi bi-geo-alt me-1"></i>@Model.AddressLine, @Model.Locality, @Model.City @Model.PostalCode</p>

            <h2 class="h6 text-uppercase text-muted fw-bold mb-2">About</h2>
            <p class="mb-4">@Model.Description</p>

            <h2 class="h6 text-uppercase text-muted fw-bold mb-3">Services offered</h2>
            <div class="list-group service-list mb-4">
                @foreach (var service in Model.ServiceOfferings)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <div class="fw-semibold">@service.Name</div>
                            @if (!string.IsNullOrWhiteSpace(service.Details))
                            {
                                <div class="small text-muted">@service.Details</div>
                            }
                        </div>
                        @if (service.PriceFrom.HasValue)
                        {
                            <div class="text-end text-nowrap">
                                <div class="fw-bold text-ink">&#8377;@service.PriceFrom.Value.ToString("N0")</div>
                                <div class="small text-muted">@service.PriceUnit</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm contact-card sticky-lg-top">
                <div class="card-body">
                    <h2 class="h6 fw-bold mb-3">Contact this business</h2>
                    <a class="btn btn-brand w-100 mb-2" href="tel:@Model.ContactPhone">
                        <i class="bi bi-telephone-fill me-1"></i>@Model.ContactPhone
                    </a>
                    @if (!string.IsNullOrWhiteSpace(Model.WhatsAppNumber))
                    {
                        <a class="btn btn-outline-success w-100 mb-2" href="https://wa.me/@Model.WhatsAppNumber.TrimStart('+')" target="_blank" rel="noopener">
                            <i class="bi bi-whatsapp me-1"></i>WhatsApp
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.ContactEmail))
                    {
                        <a class="btn btn-outline-secondary w-100 mb-2" href="mailto:@Model.ContactEmail">
                            <i class="bi bi-envelope me-1"></i>Email
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.WebsiteUrl))
                    {
                        <a class="btn btn-outline-secondary w-100 mb-2" href="@Model.WebsiteUrl" target="_blank" rel="noopener">
                            <i class="bi bi-globe me-1"></i>Website
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.OpeningHours))
                    {
                        <hr />
                        <p class="small mb-0"><i class="bi bi-clock me-1"></i>@Model.OpeningHours</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (similar.Any())
    {
        <hr class="my-5" />
        <h2 class="h5 fw-bold mb-3">Similar businesses nearby</h2>
        <div class="row g-3">
            @foreach (var ad in similar)
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <partial name="_AdCard" model="ad" />
                </div>
            }
        </div>
    }
</div>
