@model DirectorySearchViewModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query) ? "Browse services" : $"Results for {Model.Query}";
}

<div class="bg-ink text-white py-4">
    <div class="container">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-12 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                    <input class="form-control border-0" name="q" value="@Model.Query" placeholder="Search services" />
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <select class="form-select border-0" name="category">
                    <option value="">All categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Slug" selected="@(category.Slug == Model.CategorySlug)">@category.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <select class="form-select border-0" name="locality">
                    <option value="">All localities</option>
                    @foreach (var locality in Model.Localities)
                    {
                        <option value="@locality" selected="@(locality == Model.Locality)">@locality</option>
                    }
                </select>
            </div>
            <div class="col-8 col-lg-2">
                <select class="form-select border-0" name="sort">
                    <option value="relevance" selected="@(Model.Sort == "relevance")">Most relevant</option>
                    <option value="newest" selected="@(Model.Sort == "newest")">Newest</option>
                    <option value="popular" selected="@(Model.Sort == "popular")">Most viewed</option>
                    <option value="name" selected="@(Model.Sort == "name")">Name A-Z</option>
                </select>
            </div>
            <div class="col-4 col-lg-1">
                <button class="btn btn-brand w-100" type="submit">Go</button>
            </div>
        </form>
    </div>
</div>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <p class="text-muted small mb-0">
            <strong class="text-ink">@Model.Results.TotalCount</strong> listing(s) found
            @if (!string.IsNullOrWhiteSpace(Model.CategorySlug))
            {
                <span>in <strong class="text-ink">@Model.Categories.FirstOrDefault(c => c.Slug == Model.CategorySlug)?.Name</strong></span>
            }
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.Query) || !string.IsNullOrWhiteSpace(Model.CategorySlug) || !string.IsNullOrWhiteSpace(Model.Locality))
        {
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Clear filters</a>
        }
    </div>

    @if (!Model.Results.Items.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-search display-5 text-muted"></i>
            <h2 class="h5 fw-bold mt-3">No listings matched that search</h2>
            <p class="text-muted">Try a broader term, or clear the locality filter.</p>
            <a class="btn btn-outline-dark" asp-action="Index">Browse everything</a>
        </div>
    }
    else
    {
        <div class="row g-3 g-lg-4">
            @foreach (var ad in Model.Results.Items)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <partial name="_AdCard" model="ad" />
                </div>
            }
        </div>

        @if (Model.Results.TotalPages > 1)
        {
            <nav class="mt-4" aria-label="Pagination">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.Results.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-q="@Model.Query" asp-route-category="@Model.CategorySlug"
                           asp-route-locality="@Model.Locality" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page - 1)">Previous</a>
                    </li>
                    @for (var i = 1; i <= Model.Results.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-q="@Model.Query" asp-route-category="@Model.CategorySlug"
                               asp-route-locality="@Model.Locality" asp-route-sort="@Model.Sort" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.Results.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-q="@Model.Query" asp-route-category="@Model.CategorySlug"
                           asp-route-locality="@Model.Locality" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
