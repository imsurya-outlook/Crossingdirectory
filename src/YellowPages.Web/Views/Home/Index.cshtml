@model HomeViewModel
@{
    ViewData["Title"] = "Find trusted local services";
    var city = ViewData["CityName"] as string ?? "your city";
}

<section class="hero text-white">
    <div class="container py-5 text-center">
        <span class="badge chip-glass mb-3">@Model.TotalListings verified listings in @city</span>
        <h1 class="display-5 fw-bold mb-3">Find a trusted local service<br class="d-none d-md-block" /> in minutes</h1>
        <p class="lead text-white-50 mb-4">Plumbers, electricians, tutors, salons, movers &mdash; browse real listings from businesses around you.</p>

        <form class="hero-search mx-auto" asp-controller="Directory" asp-action="Index" method="get">
            <div class="row g-2">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                        <input class="form-control border-0" name="q" placeholder="What do you need?" aria-label="Service" />
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <select class="form-select border-0" name="locality" aria-label="Locality">
                        <option value="">All localities</option>
                        @foreach (var locality in Model.Localities)
                        {
                            <option value="@locality">@locality</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <button class="btn btn-brand w-100 fw-semibold" type="submit">Search</button>
                </div>
            </div>
        </form>
    </div>
</section>

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
            <h2 class="h4 fw-bold mb-1">Browse by category</h2>
            <p class="text-muted small mb-0">Tap a category to see every provider near you.</p>
        </div>
    </div>
    <div class="category-grid">
        @foreach (var category in Model.Categories)
        {
            <a class="category-tile" asp-controller="Directory" asp-action="Index" asp-route-category="@category.Slug">
                <span class="category-icon"><i class="bi @category.Icon"></i></span>
                <span class="category-name">@category.Name</span>
            </a>
        }
    </div>
</section>

@if (Model.FeaturedAds.Any())
{
    <section class="bg-light-subtle py-5">
        <div class="container">
            <h2 class="h4 fw-bold mb-1">Featured this week</h2>
            <p class="text-muted small mb-4">Listings highlighted by our directory team.</p>
            <div class="row g-3 g-lg-4">
                @foreach (var ad in Model.FeaturedAds)
                {
                    <div class="col-12 col-sm-6 col-lg-3">
                        <partial name="_AdCard" model="ad" />
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="h4 fw-bold mb-1">Recently added</h2>
            <p class="text-muted small mb-0">New businesses joining the directory.</p>
        </div>
        <a class="btn btn-sm btn-outline-dark" asp-controller="Directory" asp-action="Index">View all</a>
    </div>
    <div class="row g-3 g-lg-4">
        @foreach (var ad in Model.RecentAds)
        {
            <div class="col-12 col-sm-6 col-lg-3">
                <partial name="_AdCard" model="ad" />
            </div>
        }
    </div>
</section>

<section class="container pb-5">
    <div class="cta-panel text-center p-4 p-md-5">
        <h2 class="h4 fw-bold mb-2">Run a local business?</h2>
        <p class="text-muted mb-4">Register with your email and mobile number, then publish your listing with photos and a full service menu &mdash; free.</p>
        <a class="btn btn-brand btn-lg px-4" asp-controller="Account" asp-action="Register">List your business</a>
    </div>
</section>
