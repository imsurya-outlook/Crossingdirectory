@model List<Advertisement>
@{ ViewData["Title"] = "My listings"; }

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h4 fw-bold mb-1">My listings</h1>
            <p class="text-muted small mb-0">Every listing you publish is reviewed by an administrator before it goes live.</p>
        </div>
        <a class="btn btn-brand" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>New listing</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-shop display-5 text-muted"></i>
            <h2 class="h5 fw-bold mt-3">You have not published anything yet</h2>
            <p class="text-muted">Add your business with photos and a service menu so neighbours can find you.</p>
            <a class="btn btn-brand" asp-action="Create">Create your first listing</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var ad in Model)
            {
                var badgeClass = ad.Status switch
                {
                    AdStatus.Approved => "bg-success",
                    AdStatus.Pending => "bg-warning text-dark",
                    AdStatus.Rejected => "bg-danger",
                    _ => "bg-secondary"
                };
                var photo = ad.Photos.FirstOrDefault(p => p.IsPrimary) ?? ad.Photos.FirstOrDefault();
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body d-flex flex-column flex-md-row gap-3">
                            <div class="my-ad-thumb">
                                @if (photo is not null)
                                {
                                    <img src="@photo.Url" alt="@ad.BusinessName" />
                                }
                                else
                                {
                                    <span><i class="bi @(ad.Category?.Icon ?? "bi-shop")"></i></span>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <h2 class="h6 fw-bold mb-0">@ad.BusinessName</h2>
                                    <span class="badge @badgeClass">@ad.Status</span>
                                    @if (ad.IsFeatured)
                                    {
                                        <span class="badge bg-brand text-dark">Featured</span>
                                    }
                                </div>
                                <div class="small text-muted mb-2">
                                    @ad.Category?.Name <span class="mx-1">&middot;</span> @ad.Locality
                                    <span class="mx-1">&middot;</span> @ad.ServiceOfferings.Count service(s)
                                    <span class="mx-1">&middot;</span> @ad.Photos.Count photo(s)
                                    <span class="mx-1">&middot;</span> @ad.ViewCount views
                                </div>
                                @if (!string.IsNullOrWhiteSpace(ad.ModerationNote))
                                {
                                    <div class="alert alert-warning py-2 px-3 small mb-2">
                                        <strong>Reviewer note:</strong> @ad.ModerationNote
                                    </div>
                                }
                                <div class="d-flex flex-wrap gap-2">
                                    @if (ad.Status == AdStatus.Approved)
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Directory" asp-action="Details" asp-route-id="@ad.Id" asp-route-slug="@ad.Slug">View live</a>
                                    }
                                    <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@ad.Id">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@ad.Id" method="post" onsubmit="return confirm('Delete this listing permanently?');">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
