@model Advertisement
@{
    var photo = Model.Photos.FirstOrDefault(p => p.IsPrimary) ?? Model.Photos.FirstOrDefault();
    var services = Model.ServiceOfferings.OrderBy(s => s.SortOrder).Take(3).ToList();
    var extra = Model.ServiceOfferings.Count - services.Count;
}
<div class="card ad-card h-100 border-0 shadow-sm">
    <a class="ad-card-media" asp-controller="Directory" asp-action="Details" asp-route-id="@Model.Id" asp-route-slug="@Model.Slug">
        @if (photo is not null)
        {
            <img src="@photo.Url" alt="@Model.BusinessName" loading="lazy" />
        }
        else
        {
            <span class="ad-card-placeholder"><i class="bi @(Model.Category?.Icon ?? "bi-shop")"></i></span>
        }
        @if (Model.IsFeatured)
        {
            <span class="badge bg-brand text-dark position-absolute top-0 start-0 m-2">
                <i class="bi bi-star-fill me-1"></i>Featured
            </span>
        }
    </a>
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <h3 class="h6 fw-bold mb-1">
                <a class="text-decoration-none text-ink" asp-controller="Directory" asp-action="Details" asp-route-id="@Model.Id" asp-route-slug="@Model.Slug">
                    @Model.BusinessName
                </a>
            </h3>
        </div>
        <div class="small text-muted mb-2">
            <i class="bi @(Model.Category?.Icon ?? "bi-shop") me-1"></i>@Model.Category?.Name
            <span class="mx-1">&middot;</span>
            <i class="bi bi-geo-alt me-1"></i>@Model.Locality
        </div>
        <p class="small text-body-secondary ad-card-text mb-3">@Model.Description</p>
        <div class="d-flex flex-wrap gap-1 mb-3">
            @foreach (var service in services)
            {
                <span class="badge chip">@service.Name</span>
            }
            @if (extra > 0)
            {
                <span class="badge chip chip-muted">+@extra more</span>
            }
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-brand flex-grow-1" href="tel:@Model.ContactPhone">
                <i class="bi bi-telephone-fill me-1"></i>Call
            </a>
            <a class="btn btn-sm btn-outline-secondary flex-grow-1" asp-controller="Directory" asp-action="Details" asp-route-id="@Model.Id" asp-route-slug="@Model.Slug">
                Details
            </a>
        </div>
    </div>
</div>
