@inject Microsoft.Extensions.Options.IOptions<YellowPages.Web.Options.DirectoryOptions> DirOptions
@{
    var site = DirOptions.Value.SiteName;
    var city = DirOptions.Value.CityName;
    var isAdmin = User.IsInRole(AppRoles.Admin);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#111827" />
    <title>@ViewData["Title"] &middot; @site</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-dark bg-ink sticky-top shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
            <span class="brand-mark"><i class="bi bi-book-half"></i></span>
            <span>@site</span>
        </a>

        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <form class="d-flex flex-grow-1 mx-lg-4 my-3 my-lg-0" asp-controller="Directory" asp-action="Index" method="get" role="search">
                <div class="input-group nav-search">
                    <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                    <input class="form-control border-0" type="search" name="q" placeholder="Search plumbers, tutors, salons&hellip;" aria-label="Search listings" />
                    <button class="btn btn-brand px-3" type="submit">Search</button>
                </div>
            </form>

            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Directory" asp-action="Index">Browse</a>
                </li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="MyAds" asp-action="Index">My listings</a>
                    </li>
                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-semibold" asp-controller="Admin" asp-action="Ads">
                                <i class="bi bi-shield-check me-1"></i>Admin
                            </a>
                        </li>
                    }
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>@User.DisplayName()
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">My profile</a></li>
                            <li><a class="dropdown-item" asp-controller="MyAds" asp-action="Create">Post a listing</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-1">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-brand btn-sm px-3" asp-controller="Account" asp-action="Register">Register free</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

@if (TempData["Toast"] is string toast)
{
    <div class="container mt-3">
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@toast
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<main class="flex-grow-1 pb-5">
    @RenderBody()
</main>

<footer class="bg-ink text-white-50 py-4 mt-auto">
    <div class="container small d-flex flex-column flex-md-row justify-content-between gap-2">
        <span>&copy; @DateTime.UtcNow.Year @site &middot; Local services across @city</span>
        <span class="d-flex gap-3">
            <a class="link-light text-decoration-none" asp-controller="Directory" asp-action="Index">Browse services</a>
            <a class="link-light text-decoration-none" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </span>
    </div>
</footer>

<!-- Mobile quick-action bar -->
<div class="mobile-dock d-lg-none">
    <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i><span>Home</span></a>
    <a asp-controller="Directory" asp-action="Index"><i class="bi bi-grid"></i><span>Browse</span></a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="MyAds" asp-action="Create"><i class="bi bi-plus-circle"></i><span>Post</span></a>
        <a asp-controller="MyAds" asp-action="Index"><i class="bi bi-person"></i><span>Mine</span></a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Register"><i class="bi bi-plus-circle"></i><span>Register</span></a>
        <a asp-controller="Account" asp-action="Login"><i class="bi bi-person"></i><span>Sign in</span></a>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
